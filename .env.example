# --- Supabase (REQUIRED for live backend) ---
# Supabase Dashboard > Project Settings > API se copy karein. Kabhi chat me na bhejein.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Recommendations: external partner source (OPTIONAL) ---
# Kisi partner/dusre source ki rides bhi recommendations me chahiye hon to:
# EXTERNAL_RIDES_API_URL=https://partner.example.com/api/rides
# EXTERNAL_RIDES_API_KEY=

# --- Security (production me zaroor badlein) ---
# CNIC hash salt + admin verify key (verify API ke liye)
# CNIC_HASH_SALT=random-long-secret
# ADMIN_VERIFY_KEY=random-admin-secret

# --- AI (OPTIONAL, lekin full LLM chatbot ke liye zaroori) ---
# Google AI Studio (aistudio.google.com) se free Gemini API key. Na ho to app
# rule-based AI assistant + smart matching se chalegi, chatbot LLM jawab nahi dega.
GEMINI_API_KEY=
